  l: meta.mixin-exists('mixin', $module: b);
  m: meta.mixin-exists('mixin', b);
  n: meta.global-variable-exists('variable', $module: b);
  o: meta.global-variable-exists('variable', b);
  p: meta.module-functions($module: b);
  q: meta.module-functions(b);
  r: meta.module-mixins($module: b);
  s: meta.module-mixins(b);
