<==> arguments
--rename 'a to b'

<==> input/entrypoint.scss
@use "meta";
@use "library" as a;

a {
  b: a.$variable;
  c: a.function();
  d: meta.get-function('function', $module: 'a');
  e: meta.get-function(function, false, a);
  f: meta.get-mixin('mixin', $module: 'a');
  g: meta.get-mixin('mixin', a);
  h: meta.get-module($module: 'a');
  i: meta.get-module(a);
  j: meta.function-exists('function', $module: 'a');
  k: meta.function-exists('function', a);
  l: meta.mixin-exists('mixin', $module: 'a');
  m: meta.mixin-exists('mixin', a);
  n: meta.global-variable-exists('variable', $module: 'a');
  o: meta.global-variable-exists('variable', a);
  p: meta.module-functions($module: 'a');
  q: meta.module-functions(a);
  r: meta.module-mixins($module: 'a');
  s: meta.module-mixins(a);
  t: meta.module-variables($module: 'a');
  u: meta.module-variables(a);
  @include meta.css($module: 'a');
  @include meta.css(a);
  @include a.mixin;
}

<==> output/entrypoint.scss
@use "meta";
@use "library" as b;

a {
  b: b.$variable;
  c: b.function();
  d: meta.get-function('function', $module: b);
  e: meta.get-function(function, false, b);
  f: meta.get-mixin('mixin', $module: b);
